# Django Settings
DJANGO_SECRET_KEY=your-secret-key-change-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://paperless:paperless@db:5432/paperless

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Media Storage
MEDIA_ROOT=/app/media

# Keystone Subpath Deployment (leave empty for root path)
# Set to your app slug when deploying via Keystone (e.g., /mordoc)
# Keystone will set this automatically based on your app slug
DJANGO_FORCE_SCRIPT_NAME=
